Version: 1.0
ProjectId: cc34ce45-179a-4a83-a011-949aca7faede

RestoreWorkspace: Default
SaveWorkspace: Default
AlwaysSaveHistory: Default

EnableCodeIndexing: Yes
UseSpacesForTab: Yes
NumSpacesForTab: 2
Encoding: UTF-8

RnwWeave: Sweave
LaTeX: pdfLaTeX

AutoAppendNewline: Yes
StripTrailingWhitespace: Yes

BuildType: Package
PackageUseDevtools: Yes
PackageInstallArgs: H:\\project\\stcsanalysis --no-multiarch --with-keep.source
PackageBuildArgs: H:\\project\\stcsanalysis
PackageBuildBinaryArgs: H:\\project\\stcsanalysis
PackageCheckArgs: H:\\project\\stcsanalysis
PackageRoxygenize: rd,collate,namespace
